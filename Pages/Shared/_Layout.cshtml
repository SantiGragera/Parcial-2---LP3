<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asesoría Legal Global</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-legal">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <img src="~/imagenes/logo-navbar.png" alt="Asesoría Legal Global" class="logo-empresa me-2" />
                    <span>Asesoría Legal Global</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Registro">Registro</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Documentos">Mis documentos</a>
                        </li>
                        @if (Context.Session.GetString("Usuario") is not null)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-2">@Context.Session.GetString("Usuario")</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Documentos" asp-page-handler="Salir" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="footer-legal text-center py-3 mt-auto">
        <div class="container">
            <span>&copy; 2026 Asesoría Legal Global. Todos los derechos reservados.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
